    {"id": "hybrid_rerank", "retrieval": "dense+bm25", "rerank": true, "reflection": false, "memory": false, "agent": false},
    {"id": "agentic_rag", "retrieval": "dense+bm25", "rerank": true, "reflection": true, "memory": true, "agent": true},
    {"id": "single_agent", "retrieval": "dense+bm25", "rerank": true, "reflection": true, "memory": true, "agent": "single"}
