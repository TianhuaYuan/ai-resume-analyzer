# 生产环境变量模板：cp .env.prod.example .env && vim .env

DOCKER_REGISTRY=docker.io
DOCKER_REPO=your-username/ai-resume-analyzer
IMAGE_TAG=latest

# !! 必填
MYSQL_ROOT_PASSWORD=CHANGE_ME_to_a_strong_password_16chars
MYSQL_PORT=3306

CHAT_API_KEY=sk-your-deepseek-key
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-v4-flash

EMBEDDING_API_KEY=sk-your-embedding-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

RERANK_API_KEY=sk-your-embedding-key
RERANK_BASE_URL=https://ws-tbndiow7k9bi7egy.cn-beijing.maas.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_MODEL=qwen3-vl-rerank

CHROMA_PERSIST_DIR=./chroma_data

# 生成：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_to_at_least_32_characters_long_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
LOG_LEVEL=INFO
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_ASK=20/minute

FRONTEND_HTTP_PORT=80
FRONTEND_HTTPS_PORT=443
BACKEND_PORT=8000
