# 生产环境配置模板
# 用法：cp .env.prod.example .env.prod && vim .env.prod
# 部署：docker compose -f docker-compose.prod.yml --env-file backend/.env.prod up -d
#
# 注意：
# 1. 所有 CHANGE_ME_* 占位符必须替换为真实值
# 2. APP_ENV 固定为 prod（由 docker-compose.prod.yml 注入，无需手动设置）
# 3. DATABASE_URL / REDIS_URL 由 docker-compose.prod.yml 覆盖为容器内网络地址
# 4. 部署后此文件需保密（含 API Key 与密钥），不要提交到 Git

# ── API Keys ──
CHAT_API_KEY=CHANGE_ME_XIAOMI_KEY
CHAT_BASE_URL=https://api.xiaomimimo.com/v1
CHAT_MODEL=mimo-v2.5

EMBEDDING_API_KEY=CHANGE_ME_DASHSCOPE_KEY
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

RERANK_API_KEY=CHANGE_ME_RERANK_KEY
RERANK_BASE_URL=https://ws-tbndiow7k9bi7egy.cn-beijing.maas.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_MODEL=qwen3-vl-rerank

# 评审 LLM（生产环境建议启用，提升 RAG 答案质量）
JUDGE_API_KEY=CHANGE_ME_DEEPSEEK_KEY
JUDGE_BASE_URL=https://api.deepseek.com
JUDGE_MODEL=deepseek-v4-flash
JUDGE_TEMPERATURE=0.0
JUDGE_ENABLED=True
JUDGE_FALLBACK_TO_CHAT=False

# ── 数据库（由 docker-compose.prod.yml 覆盖为 mysql:3306） ──
# 占位值，实际生效的是 docker-compose.prod.yml 中的 environment
DATABASE_URL=mysql+aiomysql://root:CHANGE_ME_MYSQL_PASSWORD@mysql:3306/resume_ai
CHROMA_PERSIST_DIR=./chroma_data

# MySQL root 密码（docker-compose.prod.yml 中 MYSQL_ROOT_PASSWORD 使用）
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_PASSWORD

# ── JWT ──
# 生成：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_64_HEX_CHARS_AT_LEAST
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS（生产域名，逗号分隔，无空格） ──
# 示例：https://resume.example.com,https://www.resume.example.com
CORS_ORIGINS=https://your-production-domain.com
LOG_LEVEL=WARNING

# ── 上传 ──
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ── 环境 ──
ENVIRONMENT=production

# ── 限流（生产可按压力调整） ──
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_ASK=20/minute
RATE_LIMIT_REFRESH=5/minute
RATE_LIMIT_PASSWORD_RESET=3/minute

# ── 请求体 ──
MAX_REQUEST_BODY_MB=10

# ── Cookie（生产环境强制 Secure） ──
COOKIE_SECURE=True
COOKIE_SAMESITE=lax
AUTH_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token

# ── PII 脱敏 ──
REDACT_PII_OUTPUT=False

# ── MCP ──
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
MCP_TOKEN=CHANGE_ME_MCP_TOKEN

# ── Redis（由 docker-compose.prod.yml 覆盖为 redis:6379） ──
REDIS_URL=redis://redis:6379/0

# ── Token 限额（生产环境启用） ──
TOKEN_QUOTA_ENABLED=True
# 每日 token 限额（输入+输出），按成本调整
TOKEN_QUOTA_DAILY_LIMIT=10000
# 预检查时的最小预留额度
TOKEN_QUOTA_MIN_RESERVE=500

# ── RabbitMQ 消息队列（生产/预发启用，后台静默分析） ──
RABBITMQ_ENABLED=True
# AMQP 连接 URL
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
# 分析任务队列名
RABBITMQ_QUEUE=ai_resume_analyze

# ── 监控（生产/预发必填，否则启动失败） ──
METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN

# ── 运行时 ──
UVICORN_WORKERS=4

# ── 管理员邮箱（逗号分隔） ──
ADMIN_EMAILS=admin@your-domain.com

# ── 邮件发送（生产环境用 SMTP 真实发邮件） ──
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=465
SMTP_USERNAME=noreply@your-domain.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
# False=SMTP_SSL(465)，True=SMTP+starttls(587)
SMTP_USE_TLS=False
SMTP_FROM=noreply@your-domain.com
# 前端基础 URL（生产域名，用于密码重置链接）
FRONTEND_BASE_URL=https://your-production-domain.com

# ── React Agent ──
REACT_MAX_TOOL_ROUNDS=6
REACT_MAX_ITER_TOKENS=16000
REACT_TOOL_RESULT_MAX_CHARS=2000
REACT_KEEP_LAST_ROUNDS=4

# ── Thinking ──
THINKING_ENABLED=True
THINKING_EFFORT=high

# ── 简历编辑器 ──
TEMPLATE_DIR=backend/templates
BUILDER_PARSE_MODEL=

# ── /ask/agent 独立限流 ──
RATE_LIMIT_ASK_AGENT=8/minute

# ── RAG 常量 ──
DEFAULT_HYBRID_TOP_K=20
DEFAULT_RERANK_TOP_K=5
DEFAULT_GENERATE_TEMPERATURE=0.3
MCP_HTTP_TIMEOUT_TOTAL=30
MCP_HTTP_TIMEOUT_CONNECT=10

# ── Docker 部署相关（CD 流水线读取） ──
DOCKER_REGISTRY=docker.io
DOCKER_REPO=your-dockerhub-username/ai-resume-analyzer
IMAGE_TAG=latest
FRONTEND_HTTP_PORT=80
FRONTEND_HTTPS_PORT=443
