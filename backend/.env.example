# 本地开发环境配置模板（开源本地 Docker 个人工具）
# 用法：
#   开发模式：cp .env.example .env.dev，填入 CHANGE_ME_* 占位符，uvicorn main:app
#   Docker：   cp .env.example .env.dev，填入后 docker compose up -d --build
#             （compose 的 environment 会覆盖容器内地址，无需改本地 host 配置）

# ── 对话模型（DeepSeek，OpenAI 兼容）──
CHAT_API_KEY=CHANGE_ME_DEEPSEEK_KEY
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-v4-flash

# ── Embedding（阿里百炼 DashScope）──
EMBEDDING_API_KEY=CHANGE_ME_DASHSCOPE_KEY
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

# ── Rerank（百炼工作空间专用端点，需换成自己的，否则 401/404 且静默降级）──
RERANK_API_KEY=CHANGE_ME_RERANK_KEY
RERANK_BASE_URL=CHANGE_ME_RERANK_ENDPOINT
RERANK_MODEL=qwen3-vl-rerank

# ── 评审模型（中间轮/评分，可复用 CHAT 的 Key）──
JUDGE_API_KEY=CHANGE_ME_DEEPSEEK_KEY
JUDGE_BASE_URL=https://api.deepseek.com
JUDGE_MODEL=deepseek-v4-flash
JUDGE_TEMPERATURE=0.0
JUDGE_ENABLED=True
JUDGE_FALLBACK_TO_CHAT=False

# ── 数据库（开发模式：本地 MySQL；Docker 下由 compose environment 覆盖为 mysql:3306）──
DATABASE_URL=mysql+aiomysql://root:CHANGE_ME_MYSQL_PASSWORD@localhost:3306/resume_ai
CHROMA_PERSIST_DIR=./chroma_data

# MySQL root 密码（docker compose 的 MYSQL_ROOT_PASSWORD 使用，未填默认 resume_local_root）
MYSQL_ROOT_PASSWORD=CHANGE_ME_LOCAL_ROOT_PASSWORD

# ── JWT ──
# 生成：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_64_HEX_CHARS_AT_LEAST
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token

# ── CORS（前端开发地址）──
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# ── 上传与请求体 ──
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
MAX_REQUEST_BODY_MB=10

# ── 环境 ──
ENVIRONMENT=development

# ── 限流 ──
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_ASK=20/minute
RATE_LIMIT_ASK_AGENT=8/minute
RATE_LIMIT_REFRESH=5/minute
RATE_LIMIT_PASSWORD_RESET=3/minute

# ── Cookie（本地开发不用 Secure）──
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# ── PII 脱敏 ──
REDACT_PII_OUTPUT=False

# ── MCP（本机挂载路径，token 空则不鉴权）──
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
MCP_TOKEN=

# ── Redis（缺失时内存降级）──
REDIS_URL=redis://localhost:6379/0

# ── Token 限额（本地默认关；如需看用量可在管理后台开启）──
TOKEN_QUOTA_ENABLED=False
TOKEN_QUOTA_DAILY_LIMIT=10000
TOKEN_QUOTA_MIN_RESERVE=500

# ── RabbitMQ（本地默认关，降级 asyncio；Docker compose 内可启用）──
RABBITMQ_ENABLED=False
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_QUEUE=ai_resume_analyze

# ── 监控（可选，本地不强制）──
METRICS_TOKEN=

# ── 运行时 ──
UVICORN_WORKERS=1

# ── 管理员邮箱（逗号分隔；本地 Docker 下首注册用户自动为管理员，可留空）──
ADMIN_EMAILS=

# ── 本地个人工具开关 ──
# 注册免邮箱验证码（验证码打日志，忘记密码仍走验证码）
SKIP_EMAIL_VERIFICATION=True
# 首注册用户自动成为管理员
BOOTSTRAP_FIRST_USER_ADMIN=True

# ── 邮件（开发用 log：验证码输出到后端控制台日志）──
EMAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=False
SMTP_FROM=
FRONTEND_BASE_URL=http://localhost:5173

# ── React Agent ──
REACT_MAX_TOOL_ROUNDS=6
REACT_MAX_ITER_TOKENS=16000
REACT_TOOL_RESULT_MAX_CHARS=2000
REACT_KEEP_LAST_ROUNDS=4

# ── RAG 常量 ──
DEFAULT_HYBRID_TOP_K=20
DEFAULT_RERANK_TOP_K=5
DEFAULT_GENERATE_TEMPERATURE=0.3
MCP_HTTP_TIMEOUT_TOTAL=30
MCP_HTTP_TIMEOUT_CONNECT=10

# ── 博查联网搜索（可选；空则不启用联网/岗位搜索增强）──
BOCHA_API_KEY=
BOCHA_PROXY=

# ── Thinking ──
THINKING_ENABLED=True
LLM_INPUT_COST_PER_MILLION_USD=0
LLM_OUTPUT_COST_PER_MILLION_USD=0
THINKING_EFFORT=high

# ── 简历编辑器 ──
TEMPLATE_DIR=backend/templates
BUILDER_PARSE_MODEL=

# ── 数据清理（默认关）──
ORPHAN_AUTO_CLEANUP_ENABLED=False
EXPIRED_RESUME_CLEANUP_ENABLED=False
EXPIRED_RESUME_CLEANUP_INTERVAL_HOURS=24
