# Chat — DeepSeek（v4-flash ¥1/2 测试用，v4-pro ¥3/6 演示用，同一 API key）
CHAT_API_KEY=sk-your-deepseek-key
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-v4-flash

# Embedding — 阿里百炼
EMBEDDING_API_KEY=sk-your-embedding-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

# Rerank — 阿里百炼
RERANK_API_KEY=sk-your-embedding-key
RERANK_BASE_URL=https://ws-tbndiow7k9bi7egy.cn-beijing.maas.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_MODEL=qwen3-vl-rerank

DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/resume_ai

CHROMA_PERSIST_DIR=./chroma_data

# JWT 密钥（≥32字符）：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5173,http://localhost:5174
LOG_LEVEL=INFO

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
