# 环境配置模板
# 用法：cp .env.example .env.dev && vim .env.dev

# ── API Keys ──
CHAT_API_KEY=sk-your-xiaomi-key
CHAT_BASE_URL=https://api.xiaomimimo.com/v1
CHAT_MODEL=mimo-v2.5

EMBEDDING_API_KEY=sk-your-embedding-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

RERANK_API_KEY=sk-your-embedding-key
RERANK_BASE_URL=https://ws-tbndiow7k9bi7egy.cn-beijing.maas.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_MODEL=qwen3-vl-rerank

JUDGE_API_KEY=sk-your-deepseek-key
JUDGE_BASE_URL=https://api.deepseek.com
JUDGE_MODEL=deepseek-v4-flash
JUDGE_TEMPERATURE=0.0
JUDGE_ENABLED=False
JUDGE_FALLBACK_TO_CHAT=False

# ── 数据库 ──
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/resume_ai
CHROMA_PERSIST_DIR=./chroma_data

# ── JWT ──
# 生成：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
LOG_LEVEL=INFO

# ── 上传 ──
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ── 环境 ──
ENVIRONMENT=development

# ── 限流 ──
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_ASK=20/minute
RATE_LIMIT_REFRESH=5/minute

# ── 请求体 ──
MAX_REQUEST_BODY_MB=10

# ── Cookie ──
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# ── PII 脱敏 ──
REDACT_PII_OUTPUT=False

# ── MCP ──
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
MCP_TOKEN=

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── Token 限额（仅生产环境生效） ──
# 总开关：是否启用每日token限额
TOKEN_QUOTA_ENABLED=False
# 每日token限额（输入+输出），默认10000
TOKEN_QUOTA_DAILY_LIMIT=10000
# 预检查时的最小预留额度（低于此值就拒绝请求）
TOKEN_QUOTA_MIN_RESERVE=500

# ── 监控 ──
METRICS_TOKEN=

# ── 运行时 ──
UVICORN_WORKERS=4
