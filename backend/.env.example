# AI Resume Analyzer 完整环境变量模板
# 复制为 .env.dev 后填写 CHANGE_ME_*；不要提交真实密钥。

# ── 环境选择 ──
# 选择加载的环境文件：dev/test/staging/prod。
APP_ENV=dev
# 运行环境标识，影响生产安全校验。
ENVIRONMENT=development
# 应用日志级别。
LOG_LEVEL=INFO

# ── 模型统一配置顺序：URL → API Key → Model → 输入/输出计费 ──
# 对话模型 API 地址。
CHAT_BASE_URL=CHANGE_ME_CHAT_BASE_URL
# 对话模型 API 密钥。
CHAT_API_KEY=CHANGE_ME_CHAT_API_KEY
# 对话/Agent 模型名称。
CHAT_MODEL=CHANGE_ME_CHAT_MODEL
# 主模型输入 Token 每百万人民币（CNY）价格。
CHAT_INPUT_COST_PER_MILLION_CNY=0
# 主模型输出 Token 每百万人民币（CNY）价格。
CHAT_OUTPUT_COST_PER_MILLION_CNY=0
# Judge 评测模型 API 地址。
JUDGE_BASE_URL=CHANGE_ME_JUDGE_BASE_URL
# Judge 评测模型 API 密钥。
JUDGE_API_KEY=CHANGE_ME_JUDGE_API_KEY
# Judge 模型名称。
JUDGE_MODEL=CHANGE_ME_JUDGE_MODEL
# Judge 输入 Token 每百万人民币（CNY）价格。
JUDGE_INPUT_COST_PER_MILLION_CNY=
# Judge 输出 Token 每百万人民币（CNY）价格。
JUDGE_OUTPUT_COST_PER_MILLION_CNY=
# 唯一 fallback provider API 地址。
CHAT_FALLBACK_1_BASE_URL=
# 唯一 fallback provider API 密钥。
CHAT_FALLBACK_1_API_KEY=
# 唯一 fallback provider 模型名称。
CHAT_FALLBACK_1_MODEL=
# Fallback 输入 Token 每百万人民币（CNY）价格。
CHAT_FALLBACK_1_INPUT_COST_PER_MILLION_CNY=0
# Fallback 输出 Token 每百万人民币（CNY）价格。
CHAT_FALLBACK_1_OUTPUT_COST_PER_MILLION_CNY=0
# Embedding 服务 API 地址。
EMBEDDING_BASE_URL=CHANGE_ME_EMBEDDING_BASE_URL
# Embedding API 密钥。
EMBEDDING_API_KEY=CHANGE_ME_EMBEDDING_API_KEY
# Embedding 模型名称。
EMBEDDING_MODEL=CHANGE_ME_EMBEDDING_MODEL
# Embedding Batch File 向量输入：0.25 元/百万 tokens。
EMBEDDING_BATCH_FILE_INPUT_COST_PER_MILLION_CNY=0.25
# Reranker 服务 API 地址。
RERANK_BASE_URL=CHANGE_ME_RERANK_BASE_URL
# Reranker API 密钥。
RERANK_API_KEY=CHANGE_ME_RERANK_API_KEY
# Reranker 模型名称。
RERANK_MODEL=CHANGE_ME_RERANK_MODEL
# Reranker 文字输入价格：按供应商价目填写，单位元/百万 tokens。
RERANK_TEXT_INPUT_COST_PER_MILLION_CNY=0
# Reranker 图片输入价格：按供应商价目填写，单位元/百万 tokens。
RERANK_IMAGE_INPUT_COST_PER_MILLION_CNY=0
# ── Judge 行为 ──
# 评测模型随机性。
JUDGE_TEMPERATURE=0.0
# 是否启用 Judge。
JUDGE_ENABLED=True
# Judge 失败时是否回退主模型。
JUDGE_FALLBACK_TO_CHAT=False
# ── Thinking ──
# 是否启用模型思考。
THINKING_ENABLED=True
# 模型思考强度。
THINKING_EFFORT=high

# ── 可观测性（可选 LangSmith；默认关闭）──
# 可选 LangSmith/LangChain tracing API 密钥。
LANGCHAIN_API_KEY=
# 是否上报 LangSmith tracing。
LANGCHAIN_TRACING_V2=False
# LangSmith 项目名称。
LANGCHAIN_PROJECT=resume-artifact-agent
# LangSmith 服务地址。
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── 数据库 / 存储 ──
# 应用数据库连接串。
DATABASE_URL=mysql+aiomysql://root:CHANGE_ME_MYSQL_PASSWORD@localhost:3306/resume_ai
# Docker MySQL root 初始密码。
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
# Chroma 向量库本地持久化目录。
CHROMA_PERSIST_DIR=./chroma_data
# 用户上传文件保存目录。
UPLOAD_DIR=./uploads
# 单个上传文件大小上限（MB）。
MAX_UPLOAD_SIZE_MB=10
# 单次 HTTP 请求体大小上限（MB）。
MAX_REQUEST_BODY_MB=10
# 前端展示的简历解析预计耗时（秒）。
ESTIMATED_PARSE_SECONDS=5
# 前端展示的结果物化预计耗时（秒）。
ESTIMATED_MATERIALIZE_SECONDS=15

# ── JWT / Cookie / CORS ──
# JWT 签名密钥，至少 32 个字符。
JWT_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARS
# JWT 签名算法。
JWT_ALGORITHM=HS256
# 访问令牌有效期（分钟）。
ACCESS_TOKEN_EXPIRE_MINUTES=30
# 刷新令牌有效期（天）。
REFRESH_TOKEN_EXPIRE_DAYS=7
# 访问令牌 Cookie 名称。
AUTH_COOKIE_NAME=access_token
# 刷新令牌 Cookie 名称。
REFRESH_COOKIE_NAME=refresh_token
# 允许跨域访问的前端 origin，逗号分隔。
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# 是否仅通过 HTTPS 发送 Cookie。
COOKIE_SECURE=False
# Cookie 的 SameSite 策略。
COOKIE_SAMESITE=lax
# 前端基础地址，用于生成链接。
FRONTEND_BASE_URL=http://localhost:5173
# 是否在输出中脱敏手机号、邮箱等个人信息。
REDACT_PII_OUTPUT=False

# ── 限流 ──
# 默认接口限流规则。
RATE_LIMIT_DEFAULT=60/minute
# 登录接口限流规则。
RATE_LIMIT_LOGIN=10/minute
# 注册接口限流规则。
RATE_LIMIT_REGISTER=5/minute
# 普通问答接口限流规则。
RATE_LIMIT_ASK=20/minute
# Agent 问答接口限流规则。
RATE_LIMIT_ASK_AGENT=8/minute
# 高耗 LLM 接口统一限流规则。
RATE_LIMIT_LLM=10/minute
# 刷新令牌接口限流规则。
RATE_LIMIT_REFRESH=5/minute
# 忘记密码接口限流规则。
RATE_LIMIT_PASSWORD_RESET=3/minute

# ── MCP / Redis / RabbitMQ ──
# MCP Server 地址。
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
# MCP Server 认证令牌；为空表示不鉴权。
MCP_TOKEN=
# Redis 连接地址；不可用时使用内存降级。
REDIS_URL=redis://localhost:6379/0
# 是否启用 RabbitMQ 异步任务队列。
RABBITMQ_ENABLED=False
# RabbitMQ AMQP 连接串。
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# RabbitMQ 任务队列名称。
RABBITMQ_QUEUE=ai_resume_analyze
# 消费者预取的未完成消息数量。
RABBITMQ_PREFETCH_COUNT=1
# 单条消息最大重试次数。
RABBITMQ_MAX_RETRIES=3

# ── Token quota / 审批 / 写入 ──
# 是否启用每日 Token 配额。
TOKEN_QUOTA_ENABLED=False
# 每个用户每日 Token 总额度。
TOKEN_QUOTA_DAILY_LIMIT=10000
# 接受请求所需的最小 Token 预留量。
TOKEN_QUOTA_MIN_RESERVE=500
# Agent 请求开始时默认预留的 Token 数。
TOKEN_QUOTA_RESERVE_ESTIMATE=2000
# 工具审批门模式：sse/always/off。
TOOL_APPROVAL_MODE=sse
# 无交互调用遇到高风险工具时的处理策略。
TOOL_APPROVAL_HEADLESS_MODE=deny
# 是否通过 ProposalCommitService 提交 Agent 写入。
AGENT_PROPOSAL_COMMIT_ENABLED=True
# 是否自动应用 Agent 提案；生产建议关闭。
AGENT_PROPOSAL_AUTO_APPLY=False

# ── Agent / LLM 超时与熔断 ──
# 单次 ReAct 最多工具调用轮数。
REACT_MAX_TOOL_ROUNDS=6
# 单次 ReAct 最大迭代 Token 数。
REACT_MAX_ITER_TOKENS=16000
# 传给模型的单个工具结果最大字符数。
REACT_TOOL_RESULT_MAX_CHARS=2000
# 上下文中保留的最近 ReAct 轮数。
REACT_KEEP_LAST_ROUNDS=4
# 单轮 ReAct LLM 调用超时（秒）。
REACT_LLM_TIMEOUT=90
# 整次 ReAct 会话最长墙钟时间（秒）。
REACT_MAX_DURATION_SEC=180
# 同步简历分析的 LLM 调用超时（秒）。
ANALYZE_LLM_TIMEOUT=90
# 简历分析分布式锁 TTL（秒）。
ANALYZE_LOCK_TTL_SECONDS=600
# 通用 LLM 生成调用超时（秒）。
LLM_GENERATE_TIMEOUT=60
# 连续失败多少次后打开 LLM 熔断器。
LLM_BREAKER_FAILURE_THRESHOLD=5
# 熔断器打开后等待恢复探测的秒数。
LLM_BREAKER_RECOVERY_SECONDS=30
# LLM 失败诊断文件目录；为空则关闭落盘。
LLM_DIAGNOSTICS_DIR=

# ── WebSocket / Runtime ──
# 每个用户允许的最大 WebSocket 连接数。
WS_MAX_CONNECTIONS_PER_USER=5
# WebSocket 空闲连接超时（秒）。
WS_IDLE_TIMEOUT_SECONDS=300
# Uvicorn worker 进程数；进程内审批状态要求单 worker。
UVICORN_WORKERS=1

# ── RAG / MCP 常量 ──
# Hybrid RAG 初始召回文档数。
DEFAULT_HYBRID_TOP_K=20
# Rerank 后保留给生成模型的文档数。
DEFAULT_RERANK_TOP_K=5
# 普通生成模型的 temperature。
DEFAULT_GENERATE_TEMPERATURE=0.3
# MCP 请求总超时（秒）。
MCP_HTTP_TIMEOUT_TOTAL=30
# MCP 建立连接超时（秒）。
MCP_HTTP_TIMEOUT_CONNECT=10

# ── 外部解析与联网搜索（可选）──
# 博查 Web Search API 密钥；为空则关闭联网搜索。
BOCHA_API_KEY=
# 博查请求专用 HTTP 代理；为空则直连。
BOCHA_PROXY=
# 是否启用 MinerU 精准文档解析。
MINERU_ENABLED=False
# MinerU API token。
MINERU_TOKEN=
# MinerU API 地址。
MINERU_BASE_URL=https://mineru.net/api/v4
# MinerU 解析模式，如 pipeline/vlm。
MINERU_MODEL_VERSION=vlm
# MinerU 任务轮询总超时（秒）。
MINERU_TIMEOUT=300
# MinerU 任务轮询间隔（秒）。
MINERU_POLL_INTERVAL=3
# 是否解析文档表格。
MINERU_ENABLE_TABLE=True
# 是否解析文档公式。
MINERU_ENABLE_FORMULA=True
# MinerU 文档语言代码。
MINERU_LANGUAGE=ch

# ── 简历编辑器 / 模板 ──
# 简历模板文件目录。
TEMPLATE_DIR=backend/templates
# 简历编辑器解析模型；为空使用 CHAT_MODEL。
BUILDER_PARSE_MODEL=
# 是否启用严格 function-calling schema。
TOOL_CALL_STRICT=False

# ── 管理员 / 邮件 ──
# 管理员邮箱列表，逗号分隔。
ADMIN_EMAILS=
# 开发环境是否跳过邮箱验证码。
SKIP_EMAIL_VERIFICATION=True
# 首个注册用户是否自动成为管理员。
BOOTSTRAP_FIRST_USER_ADMIN=True
# 邮件提供方式：log 写日志，smtp 真实发送。
EMAIL_PROVIDER=log
# SMTP 服务器地址。
SMTP_HOST=
# SMTP 服务器端口。
SMTP_PORT=465
# SMTP 登录用户名。
SMTP_USERNAME=
# SMTP 登录密码。
SMTP_PASSWORD=
# 是否使用 STARTTLS；465 通常填 False。
SMTP_USE_TLS=False
# 邮件发件人地址。
SMTP_FROM=

# ── 后台周期任务 / 清理 / Memory ──
# 是否启用后台周期任务。
PERIODIC_TASKS_ENABLED=False
# 清理 stale processing 任务的间隔（分钟）。
STALE_CLEANUP_INTERVAL_MINUTES=30
# Memory consolidation 周期（小时）。
MEMORY_CONSOLIDATE_INTERVAL_HOURS=6
# 孤儿数据扫描周期（小时）。
ORPHAN_SCAN_INTERVAL_HOURS=24
# 每次 Memory consolidation 最大用户数。
MEMORY_CONSOLIDATE_MAX_USERS_PER_RUN=100
# 是否自动删除孤儿数据。
ORPHAN_AUTO_CLEANUP_ENABLED=False
# 是否自动清理过期简历。
EXPIRED_RESUME_CLEANUP_ENABLED=False
# 过期简历清理周期（小时）。
EXPIRED_RESUME_CLEANUP_INTERVAL_HOURS=24
# 是否启用 Memory 提炼。
MEMORY_EXTRACTION_ENABLED=False
# 单用户 Memory 提炼节流间隔（秒）。
MEMORY_EXTRACTION_INTERVAL_SEC=600

# ── 监控（后端使用）──
# Prometheus /metrics 鉴权 token；生产环境必填。
METRICS_TOKEN=

# ── Docker（compose 使用的变量也可放根目录 .env）──
# Docker 镜像仓库地址。
DOCKER_REGISTRY=docker.io
# Docker 镜像仓库路径。
DOCKER_REPO=
# Docker 镜像 tag。
IMAGE_TAG=latest
# 宿主机映射的 MySQL 端口。
MYSQL_PORT=3306
# 宿主机映射的前端 HTTP 端口。
FRONTEND_HTTP_PORT=80
# 宿主机映射的前端 HTTPS 端口。
FRONTEND_HTTPS_PORT=443
# 宿主机映射的后端 API 端口。
BACKEND_PORT=8000
