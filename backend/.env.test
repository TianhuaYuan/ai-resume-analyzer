# CI 测试环境
# 用法：APP_ENV=test python -m pytest tests/
# 说明：无 Redis/无 MQ，降级为内存 + BackgroundTasks

# ── API Keys ──
CHAT_API_KEY=test
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-v4-flash

EMBEDDING_API_KEY=test
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

RERANK_API_KEY=test
RERANK_BASE_URL=https://example.com
RERANK_MODEL=qwen3-vl-rerank

JUDGE_API_KEY=test
JUDGE_BASE_URL=https://api.deepseek.com
JUDGE_MODEL=deepseek-v4-flash
JUDGE_TEMPERATURE=0.0
JUDGE_ENABLED=False
JUDGE_FALLBACK_TO_CHAT=False

# ── 数据库 ──
DATABASE_URL=sqlite+aiosqlite:///./test.db
CHROMA_PERSIST_DIR=./chroma_data

# ── JWT ──
JWT_SECRET_KEY=test-secret-key-for-pytest-this-is-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token

# ── CORS ──
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
LOG_LEVEL=DEBUG

# ── 上传 ──
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ── 环境 ──
ENVIRONMENT=testing

# ── 限流（测试环境全放开） ──
RATE_LIMIT_DEFAULT=1000/minute
RATE_LIMIT_LOGIN=1000/minute
RATE_LIMIT_REGISTER=1000/minute
RATE_LIMIT_ASK=1000/minute
RATE_LIMIT_REFRESH=1000/minute
RATE_LIMIT_PASSWORD_RESET=1000/minute

# ── 请求体 ──
MAX_REQUEST_BODY_MB=10

# ── Cookie ──
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# ── PII 脱敏 ──
REDACT_PII_OUTPUT=False

# ── MCP ──
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
MCP_TOKEN=test-mcp-token

# ── Redis（测试不启动 Redis，自动降级内存） ──
REDIS_URL=redis://localhost:6379/1

# ── Token 限额（测试关掉） ──
TOKEN_QUOTA_ENABLED=False
TOKEN_QUOTA_DAILY_LIMIT=10000
TOKEN_QUOTA_MIN_RESERVE=500

# ── RabbitMQ 消息队列（测试关掉，降级 BackgroundTasks） ──
RABBITMQ_ENABLED=False
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_QUEUE=ai_resume_analyze

# ── 监控（测试留空） ──
METRICS_TOKEN=

# ── 运行时 ──
UVICORN_WORKERS=4

# ── RAG 常量 ──
DEFAULT_HYBRID_TOP_K=20
DEFAULT_RERANK_TOP_K=5
DEFAULT_GENERATE_TEMPERATURE=0.3
MCP_HTTP_TIMEOUT_TOTAL=30
MCP_HTTP_TIMEOUT_CONNECT=10

# ── 管理员邮箱 ──
ADMIN_EMAILS=

# ── 邮件发送（测试用 log） ──
EMAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=False
SMTP_FROM=
FRONTEND_BASE_URL=http://localhost:5173

# ── 博查联网搜索（测试不配置 key，工具/引擎自动降级） ──
BOCHA_API_KEY=

# ── 数据清理 ──
ORPHAN_AUTO_CLEANUP_ENABLED=False
EXPIRED_RESUME_CLEANUP_ENABLED=False
EXPIRED_RESUME_CLEANUP_INTERVAL_HOURS=24
