# 测试环境：APP_ENV=test python -m pytest tests/
# conftest.py 会覆盖 DATABASE_URL 为 SQLite 内存库

CHAT_API_KEY=test
CHAT_BASE_URL=https://api.xiaomimimo.com/v1
CHAT_MODEL=mimo-v2.5

EMBEDDING_API_KEY=test
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

RERANK_API_KEY=test
RERANK_BASE_URL=https://example.com
RERANK_MODEL=qwen3-vl-rerank

# Judge — DeepSeek（测试环境用占位值，禁用真实调用）
JUDGE_API_KEY=test
JUDGE_BASE_URL=https://api.deepseek.com
JUDGE_MODEL=deepseek-v4-flash
JUDGE_TEMPERATURE=0.0
JUDGE_ENABLED=False
JUDGE_FALLBACK_TO_CHAT=False

DATABASE_URL=sqlite+aiosqlite:///./test.db

CHROMA_PERSIST_DIR=./chroma_data

JWT_SECRET_KEY=test-secret-key-for-pytest-this-is-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5173,http://localhost:5174
LOG_LEVEL=DEBUG

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

RATE_LIMIT_DEFAULT=1000/minute
RATE_LIMIT_LOGIN=1000/minute
RATE_LIMIT_REGISTER=1000/minute
RATE_LIMIT_ASK=1000/minute

MCP_TOKEN=test-mcp-token