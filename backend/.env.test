# CI 测试环境
# 用法：APP_ENV=test python -m pytest tests/

# ── API Keys ──
CHAT_API_KEY=test
CHAT_BASE_URL=https://api.xiaomimimo.com/v1
CHAT_MODEL=mimo-v2.5

EMBEDDING_API_KEY=test
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

RERANK_API_KEY=test
RERANK_BASE_URL=https://example.com
RERANK_MODEL=qwen3-vl-rerank

JUDGE_API_KEY=test
JUDGE_BASE_URL=https://api.deepseek.com
JUDGE_MODEL=deepseek-v4-flash
JUDGE_TEMPERATURE=0.0
JUDGE_ENABLED=False
JUDGE_FALLBACK_TO_CHAT=False

# ── 数据库 ──
DATABASE_URL=sqlite+aiosqlite:///./test.db
CHROMA_PERSIST_DIR=./chroma_data

# ── JWT ──
JWT_SECRET_KEY=test-secret-key-for-pytest-this-is-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
LOG_LEVEL=DEBUG

# ── 上传 ──
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ── 环境 ──
ENVIRONMENT=testing

# ── 限流 ──
RATE_LIMIT_DEFAULT=1000/minute
RATE_LIMIT_LOGIN=1000/minute
RATE_LIMIT_REGISTER=1000/minute
RATE_LIMIT_ASK=1000/minute
RATE_LIMIT_REFRESH=1000/minute

# ── 请求体 ──
MAX_REQUEST_BODY_MB=10

# ── Cookie ──
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# ── PII 脱敏 ──
REDACT_PII_OUTPUT=False

# ── MCP ──
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
MCP_TOKEN=test-mcp-token

# ── Redis ──
REDIS_URL=redis://localhost:6379/1

# ── 监控 ──
METRICS_TOKEN=

# ── 运行时 ──
UVICORN_WORKERS=4
